# =========================
# Application
# =========================
APP_NAME=mallapi


# =========================
# MariaDB
# =========================
MARIADB_ROOT_PASSWORD=root
MARIADB_DATABASE=malldb

# 로컬 PC에서 Docker DB에 접근할 포트
# 로컬 MariaDB 3306과 충돌 방지를 위해 기본 3307 사용
DB_PORT=3307

# Docker 컨테이너 내부에서 backend가 mariadb에 접근하는 주소
DB_URL=jdbc:mariadb://mariadb:3306/malldb
DB_USERNAME=admin
DB_PASSWORD=admin


# =========================
# JPA
# =========================
JPA_DDL_AUTO=update
JPA_FORMAT_SQL=false
JPA_SHOW_SQL=false


# =========================
# DB Pool
# =========================
DB_POOL_MIN_IDLE=1
DB_POOL_MAX_SIZE=5


# =========================
# Multipart
# =========================
MAX_REQUEST_SIZE=30MB
MAX_FILE_SIZE=10MB


# =========================
# Security Log
# =========================
SECURITY_LOG_LEVEL=info


# =========================
# Backend File Storage
# local 또는 s3
# =========================
FILE_STORAGE_TYPE=local

# Docker 컨테이너 내부 local upload 경로
LOCAL_UPLOAD_PATH=/app/upload


# =========================
# Kakao Login
# 본인 Kakao Developers 앱의 값으로 교체
# Redirect URI는 Kakao Developers에도 동일하게 등록해야 함
# =========================
KAKAO_REST_API_KEY=your-kakao-rest-api-key
KAKAO_CLIENT_SECRET=your-kakao-client-secret
KAKAO_REDIRECT_URI=http://localhost:5173/member/kakao


# =========================
# Frontend Vite
# =========================
VITE_API_SERVER=http://localhost:8080
VITE_FRONTEND_HOST=http://localhost:5173
VITE_KAKAO_REST_API_KEY=your-kakao-rest-api-key
VITE_KAKAO_REDIRECT_URI=http://localhost:5173/member/kakao


# =========================
# AWS S3
# FILE_STORAGE_TYPE=s3일 때만 입력
# =========================
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=